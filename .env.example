# Flask Secret Key
FLASK_SECRET_KEY=generate-a-strong-random-secret-here

# Supabase Cloud Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-publishable-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Public URL of the deployed application (update to Render URL after deploying)
# e.g. https://quizlive-app.onrender.com
SITE_URL=http://127.0.0.1:5000

# Set to false to use Supabase Cloud PostgreSQL & Auth
DEMO_MODE=false
